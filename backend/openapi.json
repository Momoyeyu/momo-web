{
  "components": {
    "schemas": {
      "ChatIn": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ChatIn",
        "type": "object"
      },
      "CheckpointCreated": {
        "description": "POST /api/checkpoints 的响应：只回新存档的定位信息。",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "slot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot"
          }
        },
        "required": [
          "id",
          "slot"
        ],
        "title": "CheckpointCreated",
        "type": "object"
      },
      "CheckpointDetail": {
        "description": "存档全文（读取/覆盖往返用）。\n\n刻意**不继承** CheckpointMeta：preview 只是列表项的展示字段，\n`_entry()` 不产出它。注意这些类型会被 FastAPI 当 response_model 校验，\n多一个必填字段就会让端点 500。",
        "properties": {
          "auto": {
            "title": "Auto",
            "type": "boolean"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/StoredMessage"
            },
            "title": "Messages",
            "type": "array"
          },
          "slot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updatedAt": {
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "auto",
          "slot",
          "createdAt",
          "updatedAt",
          "summary",
          "messages"
        ],
        "title": "CheckpointDetail",
        "type": "object"
      },
      "CheckpointIn": {
        "properties": {
          "slot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "CheckpointIn",
        "type": "object"
      },
      "CheckpointMeta": {
        "description": "存档列表项（卡片展示用）。slot 为 None 的是 auto 槽。",
        "properties": {
          "auto": {
            "title": "Auto",
            "type": "boolean"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "preview": {
            "title": "Preview",
            "type": "string"
          },
          "slot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updatedAt": {
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "auto",
          "slot",
          "createdAt",
          "updatedAt",
          "preview"
        ],
        "title": "CheckpointMeta",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InterruptIn": {
        "description": "打断回传：本回合的用户输入 + 用户实际看到的 assistant 文本（可空）。",
        "properties": {
          "assistant": {
            "default": "",
            "title": "Assistant",
            "type": "string"
          },
          "user": {
            "default": "",
            "title": "User",
            "type": "string"
          }
        },
        "title": "InterruptIn",
        "type": "object"
      },
      "LiveTranscript": {
        "description": "GET /api/checkpoints/live：前端启动时恢复字幕/backlog。",
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/StoredMessage"
            },
            "title": "Messages",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary",
          "messages"
        ],
        "title": "LiveTranscript",
        "type": "object"
      },
      "Memory": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "pinned": {
            "title": "Pinned",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "content",
          "createdAt",
          "pinned"
        ],
        "title": "Memory",
        "type": "object"
      },
      "MemoryCreated": {
        "description": "POST /api/memories 的响应：只回新建项的定位信息。",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "pinned": {
            "title": "Pinned",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "pinned"
        ],
        "title": "MemoryCreated",
        "type": "object"
      },
      "MemoryIn": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "pinned": {
            "default": false,
            "title": "Pinned",
            "type": "boolean"
          }
        },
        "required": [
          "content"
        ],
        "title": "MemoryIn",
        "type": "object"
      },
      "MemoryPatch": {
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "pinned": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pinned"
          }
        },
        "title": "MemoryPatch",
        "type": "object"
      },
      "ProbeResult": {
        "description": "MCP server 连通性探测结果（设置页状态点）。",
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "tools": {
            "title": "Tools",
            "type": "integer"
          }
        },
        "required": [
          "ok",
          "tools"
        ],
        "title": "ProbeResult",
        "type": "object"
      },
      "StoredMessage": {
        "description": "momo.db 里的一条会话消息（落库形态，不含指令）。\n\nrole 只会有两个值——begin_turn 写 user、append_sentence 写 assistant。",
        "properties": {
          "at": {
            "title": "At",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text",
          "at"
        ],
        "title": "StoredMessage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "momo-web backend",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/chat": {
      "post": {
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat"
      }
    },
    "/api/chat/interrupt": {
      "post": {
        "description": "打断：作废在途回合的落账，并把 live 尾对修正为用户实际看到的部分。\n\n幂等且与回合写入无序敏感——无论打断先于/后于回合落账到达，\n最终后端记录 = 前端展示。",
        "operationId": "interrupt_api_chat_interrupt_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterruptIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Interrupt"
      }
    },
    "/api/checkpoints": {
      "get": {
        "description": "存档槽列表（auto 置顶 + 手动按 slot 排序；preview=末条消息截断）。",
        "operationId": "list_checkpoints_api_checkpoints_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CheckpointMeta"
                  },
                  "title": "Response List Checkpoints Api Checkpoints Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Checkpoints"
      },
      "post": {
        "description": "快照当前会话新建存档；slot 指定空槽，未指定取最小编号空槽。",
        "operationId": "create_checkpoint_api_checkpoints_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CheckpointIn"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckpointCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Checkpoint"
      }
    },
    "/api/checkpoints/live": {
      "get": {
        "description": "当前会话（live 行）全文：前端启动时恢复字幕/backlog 用。",
        "operationId": "live_transcript_api_checkpoints_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveTranscript"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live Transcript"
      }
    },
    "/api/checkpoints/live/new": {
      "post": {
        "description": "开启新会话：live 非空先快照进 auto 槽，然后清空 live。",
        "operationId": "new_session_api_checkpoints_live_new_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "New Session"
      }
    },
    "/api/checkpoints/{sid}": {
      "delete": {
        "operationId": "delete_checkpoint_api_checkpoints__sid__delete",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Checkpoint"
      },
      "get": {
        "description": "存档全文（含 messages）。",
        "operationId": "get_checkpoint_api_checkpoints__sid__get",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckpointDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Checkpoint"
      },
      "put": {
        "description": "重命名 + 用当前会话内容覆盖该槽。",
        "operationId": "overwrite_checkpoint_api_checkpoints__sid__put",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CheckpointIn"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckpointMeta"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Overwrite Checkpoint"
      }
    },
    "/api/checkpoints/{sid}/load": {
      "post": {
        "description": "加载存档覆盖当前会话（当前内容先进 auto 槽）。返回存档全文。",
        "operationId": "load_checkpoint_api_checkpoints__sid__load_post",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckpointDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Load Checkpoint"
      }
    },
    "/api/extensions/probe": {
      "post": {
        "description": "对一条拓展记录做 connect + list_tools + close 探测。\n\nbody = 单条拓展配置 JSON（来自设置页，未校验故按 dict 收）；返回形状见 models.ProbeResult。\n失败不抛错——不可达的 server 只是不可见，探测本身永不阻塞 UI。",
        "operationId": "probe_extension_api_extensions_probe_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Ext",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Probe Extension"
      }
    },
    "/api/memories": {
      "get": {
        "description": "全部记忆（含 pinned 标记；前端统一列表、徽标区分）。",
        "operationId": "list_memories_api_memories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Memory"
                  },
                  "title": "Response List Memories Api Memories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Memories"
      },
      "post": {
        "operationId": "create_memory_api_memories_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Memory"
      }
    },
    "/api/memories/{mem_id}": {
      "delete": {
        "operationId": "delete_memory_api_memories__mem_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "mem_id",
            "required": true,
            "schema": {
              "title": "Mem Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Memory"
      },
      "patch": {
        "operationId": "update_memory_api_memories__mem_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "mem_id",
            "required": true,
            "schema": {
              "title": "Mem Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Memory"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Memory"
      }
    },
    "/api/state": {
      "get": {
        "description": "完整 state JSON；无任何数据返回 {}。",
        "operationId": "get_state_api_state_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get State Api State Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get State"
      },
      "put": {
        "description": "整体替换 state。",
        "operationId": "put_state_api_state_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Payload",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put State"
      }
    }
  }
}
