{
  "navigate": {
    "description": "Reach a loaded local position within 64 blocks through Baritone. height=surface resolves nearby upper terrain within one horizontal block of x/z using loaded collision data (y is optional and ignored); a cave below that terrain is not arrival. Use exact for known feet positions, indoors or ceiling dimensions; it is the default and requires the specified standable feet block, not a neighboring floor. terrain=preserve (default) only walks. terrain=adapt can clear a passage or place existing throwaway blocks using normal player actions; use it when the intention allows terrain edits and an ordinary route is blocked. It does not discover resources or supply materials.",
    "parameters": {
      "type": "object",
      "properties": {
        "height": {
          "type": "string",
          "minLength": 5,
          "maxLength": 7,
          "enum": [
            "exact",
            "surface"
          ]
        },
        "terrain": {
          "type": "string",
          "minLength": 5,
          "maxLength": 8,
          "enum": [
            "preserve",
            "adapt"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "y": {
          "type": "integer",
          "minimum": -64,
          "maximum": 319
        },
        "z": {
          "type": "integer",
          "minimum": -30000000,
          "maximum": 30000000
        }
      },
      "required": [
        "x",
        "z"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "required": [
            "y"
          ]
        },
        {
          "type": "object",
          "properties": {
            "height": {
              "type": "string",
              "minLength": 7,
              "maxLength": 7,
              "enum": [
                "surface"
              ]
            }
          },
          "required": [
            "height"
          ]
        }
      ]
    }
  },
  "follow": {
    "description": "Continuously follow a visible living entity for ticks game ticks (default 1200, one minute). Keep within three blocks when possible; keep watching and pursuing if it moves again. Reports actual distance at the end, never claims arrival if still distant. interactEntity approaches its target automatically. Menus, manual takeover and stop still interrupt control.",
    "parameters": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "ticks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      },
      "required": [
        "entityId"
      ],
      "additionalProperties": false
    }
  },
