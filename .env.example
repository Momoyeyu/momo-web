# Development only. The desktop launcher supplies its own data/resources paths.
MOMO_DATA_DIR=
MOMO_RESOURCES_DIR=
MOMO_ASR_MODELS=
# Generated in memory by the launcher; never commit real values.
MOMO_DESKTOP_TOKEN=
MOMO_DESKTOP_NONCE=

# Optional test-only inputs (never package private provider fixtures):
# MOMO_E2E_BASE_URL=http://127.0.0.1:5174
# MOMO_E2E_APP=/absolute/path/to/test-build
# MOMO_E2E_LLM_CONFIG=/private/ignored/llm.json
# MOMO_E2E_SETUP=1 # Run setup.e2e.mjs alone on a fresh native test profile.
# MOMO_E2E_TTS_CONFIG=/private/ignored/tts.json
# MOMO_BROWSER_LLM_CONFIG=/private/ignored/browser.yaml

# Local Web launcher (token is proxy-only, never VITE_*).
MOMO_API_PORT=7821
MOMO_WEB_PORT=5173
# Set by launcher: trusted exact loopback origin.
MOMO_WEB_ORIGIN=
# Development overrides; packaged desktop uses bundled JS runtime/host.
MOMO_NODE=
MOMO_PLUGIN_HOST=
# Test-only virtual channel/activity, not a public management API.
MOMO_TEST_VIRTUAL=0
